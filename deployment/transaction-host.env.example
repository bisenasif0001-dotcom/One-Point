# Backend transactional host. Copy settings into the server's secret manager/.env.
# Replace example hostname and generate secrets before production startup.
NODE_ENV=production
PORT=4173
NEXT_PUBLIC_SITE_URL=https://orders.example.com
ALLOWED_HOSTS=orders.example.com,localhost,127.0.0.1
DATABASE_URL=file:/var/lib/one-point/opds-payments.sqlite
JWT_SECRET=
ADMIN_API_TOKEN=
ADMIN_PASSWORD=
OPDS_ALLOW_LEGACY_ADMIN_TOKEN=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Add PhonePe credentials only if that gateway is enabled.
