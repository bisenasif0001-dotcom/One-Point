# ─────────────────────────────────────────────────────────────
#  One Point Digital Services — Environment Configuration
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=4173
NODE_ENV=development

# ── Security (REQUIRED — generate strong random values) ───────
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_API_TOKEN=change-me-generate-strong-random-token
JWT_SECRET=change-me-generate-strong-random-secret

# Optional security baseline controls.
# Keep true during the compatibility phase so existing scripts that send
# X-Admin-Token continue to work. Set false later only after an approved
# migration removes legacy static-token usage everywhere.
OPDS_ALLOW_LEGACY_ADMIN_TOKEN=true
ADMIN_SESSION_TTL_HOURS=8
ADMIN_CHANGE_TOKEN_TTL_MINUTES=5
# OPDS_SECURITY_AUDIT_CONSOLE=false

# ── Site URL & Allowed Hosts (Production) ──────────────────────
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# ── Google Sign-In (Google Cloud Console → OAuth 2.0 Client) ─────
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# -- Google Drive document sync (service account; disabled until the secure
# server-side binary upload worker is configured) --
# Create a dedicated Drive folder, share that folder with the service-account
# email, and keep the private key only in your production secret manager.
# GOOGLE_DRIVE_SYNC_ENABLED=false
# GOOGLE_DRIVE_PARENT_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# â”€â”€ Microsoft Sign-In (Microsoft Entra admin center â†’ App registrations) â”€â”€
# MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MICROSOFT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Use "common" for personal Microsoft accounts plus work/school accounts.
# MICROSOFT_TENANT_ID=common
# MICROSOFT_REDIRECT_URI=https://yourdomain.com/api/auth/microsoft/callback

# ── Database ──────────────────────────────────────────────────
# DATABASE_URL=file:/data/opds-payments.sqlite

# ── Razorpay (get from dashboard.razorpay.com) ────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── PhonePe (get from developer.phonepe.com) ─────────────────
PHONEPE_MERCHANT_ID=MERCHANTXXXXXXXX
PHONEPE_SALT_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PHONEPE_SALT_INDEX=1
# PHONEPE_BASE_URL=https://api.phonepe.com/apis/hermes

# ── Notification Webhooks (optional — enables real delivery) ──
# WhatsApp: Wati / 360Dialog / Meta Cloud API webhook URL
# WHATSAPP_NOTIFICATION_WEBHOOK_URL=https://your-service.com/whatsapp
# SMS: Twilio / MSG91 / Fast2SMS webhook URL
# SMS_NOTIFICATION_WEBHOOK_URL=https://your-service.com/sms
# Email: SendGrid / Mailgun / Resend webhook URL
# EMAIL_NOTIFICATION_WEBHOOK_URL=https://your-service.com/email

# ── Business GST ─────────────────────────────────────────────
# BUSINESS_GST_NUMBER=07XXXXXXXXXXXXX
